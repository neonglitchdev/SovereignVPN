# SovereignVPN — Pi-hole (FR-DNS-001/002/004/009) [H23, H24]: in rete host, socket solo sull'indirizzo di wg0, quindi dopo
# il ripristino che la crea; ambiente e password del pannello da `sovereignctl dns apply` (file 0600, mai nel log).
[Unit]
Description=SovereignVPN: Pi-hole, policy DNS solo su wg0
Requires=docker.service sovereignvpn-unbound.service
After=docker.service sovereignvpn-unbound.service sovereignvpn-reconcile.service
ConditionPathExists=/etc/sovereignvpn/dns/pihole.env

[Service]
ExecStartPre=-/usr/bin/docker rm -f sovereignvpn-pihole
ExecStart=/usr/bin/docker run --rm --name sovereignvpn-pihole --network host --env-file /etc/sovereignvpn/dns/pihole.env -v /etc/sovereignvpn/dns/pihole-web.secret:/run/secrets/pihole_webpasswd:ro -v /etc/sovereignvpn/dns/liste:/etc/pihole/sovereignvpn:ro -v sovereignvpn-pihole:/etc/pihole pihole/pihole:2026.10.1@sha256:30f803ad5dd60ff96cc0a63008a2e9271af481c1b0399a182192b2e91152c1f9
ExecStop=/usr/bin/docker stop sovereignvpn-pihole
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
